# Generate a long random value before enabling the MT5 bridge.
MT5_BRIDGE_TOKEN=replace-with-a-long-random-token

# Private password for the single-user dashboard. Use at least 8 characters.
DASHBOARD_PASSWORD=replace-with-a-strong-unique-password

# Added automatically when Neon is connected through the Vercel Marketplace.
DATABASE_URL=postgresql://user:password@host.neon.tech/database?sslmode=require
